<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.datapilot.server.mapper.MetadataColumnMapper">
    <insert id="insert">
        insert into metadata_column(table_id,column_name,data_type,column_comment,nullable,primary_key,ordinal_position)
        values(#{tableId},#{columnName},#{dataType},#{columnComment},#{nullable},#{primaryKey},#{ordinalPosition})
    </insert>

    <delete id="deleteByDatasourceId">
        delete mc
        from metadata_column mc
        inner join metadata_table mt on mc.table_id=mt.id
        where mt.data_source_id=#{datasourceId}
    </delete>

    <select id="selectByTableId"
        resultType="com.datapilot.pojo.entity.MetadataColumn">
        select * from metadata_column
        where table_id=#{tableId}
        order by ordinal_position
    </select>
</mapper>